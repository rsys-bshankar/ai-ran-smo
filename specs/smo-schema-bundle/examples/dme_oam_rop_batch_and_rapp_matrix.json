  "2_rapp_to_dme_scoped_datajob_subscription": {
    "description": "Created ONCE by the NES rApp via POST /r1/dme/v1/dataJobs to subscribe to 4 counters and 2 KPIs across all cells in SubNetwork=BLR_12.",
    "payload": {
      "dataJobId": "dj-nes-blr12-001",
      "consumerId": "rapp-nes-instance-01",
      "scope": {
        "subNetworkDn": "SubNetwork=BLR_12"
      },
      "granularityPeriodSec": 900,
      "measurementProfile": "3GPP_NES_CORE_V1",
      "selectedCounters": [
        "RRU.PrbTotDl",
        "RRC.ConnMean",
        "DRB.UEThpDl",
        "PEE.AvgPower"
      ],
      "selectedKpis": [
        "PEE.EnergyEfficiency",
        "DRB.RlcSduDropRateDl"
      ],
      "delivery": {
        "transport": "R1_WEBHOOK",
        "callbackUri": "https://rapp-nes-01.smo.svc:8443/r1/callbacks/dme-rop-matrix"
      }
    }
  },
  "3_dme_to_rapp_consolidated_rop_push": {
    "description": "Pushed ONCE per 15-min ROP by DME to the NES rApp callbackUri (containing all cells in SubNetwork=BLR_12 and only the 6 subscribed metrics).",
    "payload": {
      "dataJobId": "dj-nes-blr12-001",
      "ropEndTime": "2026-10-30T14:15:00Z",
      "subNetworkDn": "SubNetwork=BLR_12",
      "featureOrder": [
        "RRU.PrbTotDl",
        "RRC.ConnMean",
        "DRB.UEThpDl",
        "PEE.AvgPower",
        "PEE.EnergyEfficiency",
        "DRB.RlcSduDropRateDl"
      ],
      "cellsMatrix": {
        "SubNetwork=BLR_12,ManagedElement=gNB_104,GNBDUFunction=1,NRCellDU=NRCellDU-Cov-700MHz-A": [24.8, 42.0, 185.4, 710.5, 3.42, 0.08],
        "SubNetwork=BLR_12,ManagedElement=gNB_104,GNBDUFunction=1,NRCellDU=NRCellDU-Cap-3500MHz-B": [11.4, 9.0, 340.2, 980.0, 1.85, 0.04]
      }
    }
  },
  "4_rapp_to_dme_historical_window_query_and_response": {
