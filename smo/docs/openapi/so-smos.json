    "/orders/{order_id}/cancel": {
      "post": {
        "description": "Makes every PENDING step of the order CANCELLED; a COMPLETED, FAILED or RUNNING step keeps its status.\n\nThe order may still be running in another request: the row is read under a lock, and the running submit re-reads it before each step, so no step after a cancel starts. The step\nthat is RUNNING finishes. `steps` is assigned a new list: an in-place change to a plain JSON column is not persisted.",
        "operationId": "cancel_order_orders__order_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
