  "info": {
    "title": "Mock O1 Adaptor (NETCONF and RESTCONF test double)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/host-meta": {
      "get": {
        "description": "RFC 8040 section 3.1: where the RESTCONF root is.",
        "operationId": "restconf_root_discovery__well_known_host_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Restconf Root Discovery"
      }
    },
    "/capabilities": {
      "get": {
        "description": "The vendor capability declaration RAN NF OAM's vendor onboarding\nflow discovers (Wave 9 W9-03, `POST /ran-nf-oam/vendor-onboarding`\nwith `discoverFrom`, read at this fixed path on the adaptor's registered\norigin): which vendor this adaptor fronts, which MnS\nservices it implements and which O1 transports it speaks. Configurable\nper deployment so one image can stand in for several vendors.",
        "operationId": "declare_capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Declare Capabilities"
      }
    },
    "/edit-config": {
      "post": {
        "description": "Mirrors netconf_client.py's own build_edit_config_rpc/send_edit_config\nexactly: parses the real <rpc><edit-config>...</edit-config></rpc>\nrequest, replies <rpc-reply><ok/></rpc-reply> (RFC 6241 section 4.2) on\nsuccess. REJECTED (a real <rpc-error>, same as a real NETCONF agent\nrefusing a request) when the managed-object ref is missing, or its\nconfig body is empty for any operation other than delete/remove \u2014 a\ndelete legitimately carries no attribute_changes at all (RFC 6241\nsection 7.2's `operation` attribute), so rejecting it for emptiness\nwould be wrong. Non-delete/remove emptiness rejection is the same\n\"empty payload is a real, testable rejection trigger\" pattern.",
        "operationId": "edit_config_edit_config_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Edit Config"
      }
    },
    "/edit-config/{managed_object_ref}": {
      "get": {
        "description": "Not part of the real NETCONF RPC surface \u2014 a test-only introspection\nroute (matching this build's own `_policies`-dict-backed test doubles\nelsewhere) so a real integration test can assert what was actually\napplied, not just that the call returned 200.",
        "operationId": "query_last_applied_edit_config__managed_object_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "managed_object_ref",
            "required": true,
            "schema": {
              "title": "Managed Object Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Last Applied"
      }
    },
    "/emit/alarm": {
      "post": {
        "description": "FM: raise an alarm at RAN NF OAM (`POST /alarms/ingest`; its fields are query parameters there). `sourceAlarmId` defaults to a new UUID.",
        "operationId": "emit_alarm_emit_alarm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmitAlarm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmitResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MockError"
                }
              }
            },
            "description": "the body is not JSON"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "no RAN NF OAM target configured, or this adaptor does not declare the service"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "unusable target, or a body of the wrong shape"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RAN NF OAM could not be reached"
          }
        },
        "summary": "Emit Alarm"
      }
    },
